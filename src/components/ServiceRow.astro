---
import type { Service } from '../data/services';
const { service } = Astro.props as { service: Service };
const soon = service.status === 'coming-soon';
---
<article class:list={['service', { soon }]}>
  <div class="service-intro">
    <h3>
      {service.name}
      {soon && <span class="badge">Coming soon</span>}
    </h3>
    <p>{service.tagline}</p>
    <p class="best-for">{service.bestFor}</p>
  </div>
  <ul>
    {service.includes.map((item) => <li>{item}</li>)}
  </ul>
  {!soon && (
    <div class="service-price">
      {service.price ? service.price : 'Ask for a quote'}
      {service.priceUsd && <span>{service.priceUsd}</span>}
      {service.timeline && <span>{service.timeline}</span>}
      <a href="/contact/">Talk to us</a>
    </div>
  )}
</article>
