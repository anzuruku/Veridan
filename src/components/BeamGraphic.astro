---
// Two beams cross to form the X. The four ends are labelled with the four services.
---
<svg class="beams" viewBox="0 0 400 400" role="img" aria-labelledby="beams-title beams-desc">
  <title id="beams-title">Two crossing beams</title>
  <desc id="beams-desc">Websites, AI agents and online admin meet at one point.</desc>
  <g class="beam beam-a"><rect x="50" y="185" width="300" height="30" rx="3" /></g>
  <g class="beam beam-b"><rect x="50" y="185" width="300" height="30" rx="3" /></g>
  <circle class="beam-node" cx="200" cy="200" r="13" />
  <g class="beam-label">
    <text x="20" y="62">Websites</text>
    <text x="380" y="62" text-anchor="end">AI agents</text>
    <text x="20" y="344">Online admin</text>
  </g>
</svg>
