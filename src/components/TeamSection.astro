---
import type { Member } from '../data/team';
const { members } = Astro.props as { members: Member[] };

// 1 person: one wide card. 2 to 4: cards side by side. 5 or more: a grid on desktop and a swipeable row on phones.
const mode = members.length === 1 ? 'one' : members.length <= 4 ? 'few' : 'many';
const initials = (name: string) =>
  name.split(' ').filter(Boolean).slice(0, 2).map((part) => part[0].toUpperCase()).join('');
---
<div class={`team team-${mode}`} data-team={mode}>
  <ul class="team-list" aria-label="Our team">
    {members.map((member) => (
      <li class="member">
        <div class="avatar">
          {member.photo
            ? <img src={member.photo} alt={`Photo of ${member.name}`} width="96" height="96" loading="lazy" />
            : <span aria-hidden="true">{initials(member.name)}</span>}
        </div>
        <div class="member-body">
          <h3>{member.name}</h3>
          <p class="role">{member.role}</p>
          <p class="bio">{member.bio}</p>
          {member.links && member.links.length > 0 && (
            <p class="member-links">
              {member.links.map((link) => (
                <a href={link.url} rel="noopener">{link.label}</a>
              ))}
            </p>
          )}
        </div>
      </li>
    ))}
  </ul>
  {mode === 'many' && (
    <div class="team-dots" aria-hidden="true">
      {members.map(() => <span></span>)}
    </div>
  )}
</div>

<style is:global>
  .team-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.5rem; }
  .team .member { display: grid; gap: 1rem; align-content: start; padding: 1.5rem; background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); }
  .team .avatar { width: 96px; height: 96px; border-radius: 50%; overflow: hidden; background: var(--ink); color: #fff; display: grid; place-items: center; font-family: var(--font-head); font-weight: 700; font-size: 1.8rem; }
  .team .avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .team .member-body { display: grid; gap: 0.4rem; align-content: start; }
  .team .role { color: var(--blue); font-weight: 600; font-size: 0.95rem; }
  .team .bio { color: var(--mute); }
  .team .member-links { display: flex; gap: 1.25rem; margin-top: 0.5rem; font-weight: 600; }
  .team-one .team-list { max-width: 46rem; }
  @media (min-width: 640px) {
    .team-one .member { grid-template-columns: 96px 1fr; gap: 1.5rem; align-items: start; }
  }
  .team-few .team-list { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .team-many .team-list { grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); }
  .team-dots { display: none; }
  @media (max-width: 899px) {
    .team-many .team-list { display: flex; gap: 1rem; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 0.25rem; }
    .team-many .team-list::-webkit-scrollbar { display: none; }
    .team-many .member { flex: 0 0 82%; scroll-snap-align: start; }
    .team-many .team-dots { display: flex; justify-content: center; gap: 8px; margin-top: 14px; }
    .team-many .team-dots span { width: 10px; height: 10px; border-radius: 999px; background: #94a3b8; transition: width 0.3s ease, background 0.3s ease; }
    .team-many .team-dots span.on { width: 26px; background: var(--accent); }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-team="many"]');
  if (root) {
    const list = root.querySelector<HTMLElement>('.team-list')!;
    const cards = Array.from(list.querySelectorAll<HTMLElement>('.member'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.team-dots span'));
    const update = () => {
      let best = 0;
      let bestGap = Infinity;
      cards.forEach((card, i) => {
        const gap = Math.abs(card.offsetLeft - list.offsetLeft - list.scrollLeft);
        if (gap < bestGap) { best = i; bestGap = gap; }
      });
      dots.forEach((dot, i) => dot.classList.toggle('on', i === best));
    };
    list.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
