---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { team } from '../data/team';
import TeamSection from '../components/TeamSection.astro';
---
<Base
  title={`About | ${site.name}`}
  description="Who we are: a founder-led technology consultancy based in Uganda, building systems that keep working when the network does not."
  path="/about/"
>
  <section class="about">
    <div class="wrap">
      <div class="about-copy">
        <h1>We work alongside you, not just for you.</h1>
        <p>{site.teamLine}</p>
        <p>{site.placeStory}</p>
        <p>
          We make use of modern tools, including AI, to deliver faster and keep prices fair. A person designs, builds,
          tests and checks every system before it reaches you.
        </p>
        <p class="partners">
          You always know the person responsible for your work, and the founder answers for every result.
        </p>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Team</p>
        <h2>Who you will work with</h2>
      </div>
      <TeamSection members={team} />
    </div>
  </section>

  <section class="cta">
    <div class="wrap cta-inner">
      <h2>Want to work with us?</h2>
      <div class="actions">
        <a class="btn btn-amber" href="/contact/">Contact us</a>
      </div>
    </div>
  </section>
</Base>
